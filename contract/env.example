## Hardhat Sepolia deployment env
#
# Copy this file to `contract/.env` and fill values.
# DO NOT commit real private keys.

# Sepolia RPC endpoint (public or your provider)
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# Deployer private key (0x... or without 0x; Hardhat accepts both)
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Optional: verify contracts
ETHERSCAN_API_KEY=




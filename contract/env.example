## Hardhat 部署环境变量配置
#
# 复制此文件到 `contract/.env` 并填写值
# ⚠️ 永远不要提交包含真实私钥的 .env 文件！

# ============ 主网配置 ============
# 主网 RPC URL (推荐使用 Alchemy 或 Infura)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/9uCS_Wqjt5vDaR7xjjRkJ

# ============ 测试网配置 ===========
# Sepolia RPC URL
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# ============ 部署账户 ============
# 部署者私钥 (带或不带 0x 前缀都可以)
# ⚠️ 这个账户需要有足够的 ETH 支付 gas 费用
DEPLOYER_PRIVATE_KEY=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266

# ============ 可选配置 ============
# Etherscan API Key (用于验证合约)
ETHERSCAN_API_KEY=

# Gas Reporter (设为 true 生成 gas 报告)
REPORT_GAS=false

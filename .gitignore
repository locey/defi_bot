# ============================================
# DeFi Arbitrage Bot - Git Ignore Rules
# 只提交源代码和必要的配置文件
# ============================================

# ============ 敏感信息（最高优先级）============
.env
.env.local
.env.*.local
env
backend/.env
backend/env
contract/.env
contract/env
**/private_keys/
**/*.pem
**/*.key
# 本地配置覆盖（可能包含私钥）
backend/configs/config.local.yaml
backend/configs/config.secret.yaml

# ============ 编译产物 ============
# Go
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# Node.js / JavaScript
node_modules/
jspm_packages/
.npm
.eslintcache
*.tgz

# Hardhat / Smart Contract
contract/artifacts/
contract/cache/
contract/typechain/
contract/typechain-types/
contract/.openzeppelin/
coverage/
coverage.json

# ============ 日志和临时文件 ============
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# ============ 文档（仅保留 README）============
docs/
backend/docs/
contract/docs/
*.md
!README.md
!**/README.md

# ============ 测试脚本和工具 ============
scripts/
backend/scripts/
contract/scripts/
*.sh
*.ps1
!setup.sh

# ============ 数据库和数据文件 ============
*.sql
*.db
*.sqlite
postgres_data/
redis_data/
pgadmin_data/

# ============ IDE 和编辑器 ============
.idea/
.vscode/
*.iml
.project
.classpath
.settings/

# ============ OS 相关 ============
.DS_Store
Thumbs.db
Desktop.ini

# ============ 其他缓存和构建产物 ============
.next/
out/
build/
dist/
.cache/
.parcel-cache/
*.tsbuildinfo
.nyc_output/
.serverless/
.vercel/
.fusebox/
.dynamodb/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Yarn Integrity file
.yarn-integrity

# nuxt.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Claude
.claude/*
.*/*

# ============ 例外：需要保留的文件 ============
!contract/contracts/deployments/*.json
!hardhat.config.cjs
!package.json
!package-lock.json
!go.mod
!go.sum
!tsconfig.json

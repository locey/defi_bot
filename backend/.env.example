# ============================================================
# DeFi Bot 后端 - 环境变量模板
# 复制此文件到 backend/.env 并填入真实值
# cp .env.example .env
# ============================================================

# ============ Keeper 钱包（必须） ============
# 用于签名套利交易的私钥（64位 hex，不带 0x 前缀）
KEEPER_PRIVATE_KEY=

# ============ 合约部署（必须） ============
DEPLOYER_PRIVATE_KEY=

# ============ 数据库 ============
# DATABASE_HOST=127.0.0.1
# DATABASE_PASSWORD=defi_pass123

# ============ Binance CEX（可选） ============
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# ============ Telegram 通知（可选） ============
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ============ RPC URL（可选，覆盖默认公共节点） ============
# BLOCKCHAIN_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
# BLOCKCHAIN_WS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
